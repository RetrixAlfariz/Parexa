# Local-first Parexa setup. Copy to .env. Cloud API keys are optional.
CHAT_PROVIDER=lmstudio
LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
LMSTUDIO_API_KEY=lm-studio
# Empty means choose the first discovered local chat model.
LMSTUDIO_CHAT_MODEL=

# Alternative local provider: set CHAT_PROVIDER=ollama.
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_API_KEY=ollama
OLLAMA_CHAT_MODEL=

LOCAL_CHAT_CONTEXT_WINDOW=8192
LOCAL_CHAT_MAX_OUTPUT_TOKENS=2048
LOCAL_CHAT_TIMEOUT_SEC=120
LOCAL_MODEL_DISCOVERY_TIMEOUT_SEC=2
LOCAL_MAX_CONCURRENT_INFERENCE=1

# Never silently fall back to cloud for a private/local request.
CHAT_ALLOW_CLOUD_SELECTION=false
PAREXA_ALLOW_REMOTE_MODEL_SERVER=false
# To enable cloud model selection, set the flag above true and provide a key.
CEREBRAS_API_KEY=
CHAT_MODEL=gpt-oss-120b

# Embedding and chat providers are separate.
# Install/load the named local embedding model before uploading documents.
EMBEDDING_PROVIDER=lmstudio
EMBEDDING_MODEL=text-embedding-embeddinggemma-300m-qat
# Cloud embedding alternative (requires GOOGLE_API_KEY):
# EMBEDDING_PROVIDER=google
# EMBEDDING_MODEL=models/gemini-embedding-001
GOOGLE_API_KEY=
BROWSING_MODEL=gemini-flash-latest

# Local HTTP API has no authentication: leave on loopback.
PAREXA_HOST=127.0.0.1
FLASK_DEBUG=false
PORT=5000
PAREXA_MAX_UPLOAD_MB=25
PAREXA_DATA_DIR=storage/db
QDRANT_DB_PATH=storage/db/qdrant_db
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=

# Ingestion and executor tuning.
EMBEDDING_WARMUP_ON_START=false
EMBEDDING_HEALTHCHECK_ENABLED=true
EMBEDDING_HEALTHCHECK_INTERVAL_SEC=30
EMBEDDING_HEALTHCHECK_TIMEOUT_SEC=10
EMBEDDING_HEALTHCHECK_RETRY_BACKOFF_SEC=5
INGEST_OCR_SPARSE_THRESHOLD=120
PAREXA_IO_WORKERS=4
PAREXA_CPU_WORKERS=4
GENESIS_PARALLEL_CRITICS=3
