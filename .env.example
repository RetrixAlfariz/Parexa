CEREBRAS_API_KEY=your_cerebras_key_here
GOOGLE_API_KEY=your_google_ai_key_here

# Optional: store runtime data outside the repo root
PAREXA_DATA_DIR=storage/db
QDRANT_DB_PATH=storage/db/qdrant_db

# Optional: use external Qdrant server (for example via Docker)
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=

# Local-only HTTP server by default (no API authentication yet).
# Do not expose Parexa directly to public networks.
PAREXA_HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=false
PAREXA_MAX_UPLOAD_MB=25

# Optional: model overrides
CHAT_MODEL=gpt-oss-120b
# SUMMARY_MODEL=gpt-oss-120b

# Optional: ingestion + execution tuning
EMBEDDING_PROVIDER=google
EMBEDDING_MODEL=models/gemini-embedding-001
# LM Studio embedding (OpenAI-compatible endpoint)
# EMBEDDING_PROVIDER=lmstudio
# EMBEDDING_MODEL=text-embedding-embeddinggemma-300m-qat
# LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
# LMSTUDIO_API_KEY=lm-studio
# EMBEDDING_WARMUP_ON_START=true
# EMBEDDING_HEALTHCHECK_ENABLED=true
# EMBEDDING_HEALTHCHECK_INTERVAL_SEC=30
# EMBEDDING_HEALTHCHECK_TIMEOUT_SEC=10
# EMBEDDING_HEALTHCHECK_RETRY_BACKOFF_SEC=5
INGEST_OCR_SPARSE_THRESHOLD=120
PAREXA_IO_WORKERS=4
PAREXA_CPU_WORKERS=4
GENESIS_PARALLEL_CRITICS=3
